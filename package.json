{
  "name": "docker-builder",
  "version": "0.1.0",
  "description": "Docker 项目构建器",
  "author": "CaoMeiYouRen",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "lint": "cross-env NODE_ENV=production eslint src --fix",
    "typecheck": "tsc --noEmit",
    "gate": "bash gate/check-alpine-base.sh --fail docker",
    "gate:image": "bash gate/musl-pwrite-gate.sh",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_ENV=production tsup",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:tsup": "cross-env NODE_ENV=development tsup --watch",
    "start": "node ./dist/index",
    "start:tsx": "cross-env NODE_ENV=production tsx ./src/index.ts",
    "commit": "cz",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "commitizen": "^4.3.0",
    "commitlint-config-cmyr": "^1.0.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog-cmyr": "^2.0.0",
    "debug": "^4.4.3",
    "eslint": "^9.39.4",
    "eslint-config-cmyr": "^2.3.1",
    "husky": "^9.0.11",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog-cmyr"
    }
  },
  "changelog": {
    "language": "zh"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "npm run lint",
      "git add"
    ]
  },
  "keywords": [
    "tsup",
    "typescript",
    "template"
  ],
  "homepage": "https://github.com/CaoMeiYouRen/docker-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaoMeiYouRen/docker-builder.git"
  },
  "bugs": {
    "url": "https://github.com/CaoMeiYouRen/docker-builder/issues"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "fs-extra": "^11.4.1",
    "isomorphic-unfetch": "^4.0.2",
    "lodash-es": "^4.17.21",
    "log4js": "^6.9.1",
    "semver": "^7.8.5",
    "tslib": "^2.6.3",
    "yaml": "^2.9.1",
    "zx": "^8.8.5"
  }
}
